---
import { team, facts, instagramUrl, instagramHandle } from '../data/site';
import Arrow from './Arrow.astro';
import SocialIcon from './SocialIcon.astro';
import { Image } from 'astro:assets';
---
<section class="team wrap" id="time" aria-labelledby="time-title">
  <div class="head">
    <h2 id="time-title" data-reveal>Quem faz a brnz</h2>
    <div class="team-intro" data-reveal style="--i:1"><p>Design e edição, foto e filmagem, sites e automação. Você fala com quem coloca a mão no seu projeto.</p><a class="instagram-cta" href={instagramUrl} target="_blank" rel="noopener" aria-label="Ver criações e bastidores da BRNZ no Instagram"><span class="instagram-mark"><SocialIcon name="Instagram" /></span><span class="instagram-copy"><strong>Veja a BRNZ em ação</strong><small>{instagramHandle}</small></span><Arrow /></a></div>
  </div>

  <div class="body">
    <ul class="people">
      {team.map((p, i) => (
        <li class="person" data-reveal style={`--i:${i}`}>
          <div class="portrait" aria-hidden="true"><Image src={p.photo} alt="" width={336} height={336} widths={[176, 336]} sizes="(max-width: 900px) 88px, 120px" format="webp" quality={80} loading="lazy" decoding="async" /></div>
          <div class="person-copy">
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="bio">{p.bio}</p>
            {p.links && <ul class="profile-links" aria-label={`Perfis de ${p.name}`}>{p.links.map(link => <li><a href={link.url} target="_blank" rel="noopener" aria-label={`${link.label} de ${p.name}`} title={`${link.label} de ${p.name}`}><SocialIcon name={link.label} /></a></li>)}</ul>}
          </div>
        </li>
      ))}
    </ul>
    <aside class="facts on-dark" data-reveal style="--i:2" aria-label="Onde e como atendemos">
      <svg class="facts-art" aria-hidden="true"><use href="#art-waves" /></svg>
      <dl>
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </aside>
  </div>
</section>

<style>
  .team { padding-block: var(--section); }
  .head { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  h2 { font-size: var(--t-head); line-height: 1.2; }
  .head p { max-width: 58ch; font-size: var(--t-lead); line-height: 1.45; }
  .instagram-cta { display: inline-flex; align-items: center; gap: 16px; max-width: 100%; margin-top: 26px; padding: 12px 18px 12px 12px; border: 1px solid #aeb8ff33; border-radius: 22px; background: var(--paper-2); color: var(--on-dark); text-decoration: none; text-align: left; transition: transform 250ms var(--ease-out), border-color 250ms, box-shadow 250ms; }
  .instagram-mark { display: grid; place-items: center; width: 52px; height: 52px; flex: none; border-radius: 16px; background: radial-gradient(circle at 25% 110%, #ffd776 0%, #f35d40 35%, #c32c96 65%, #6144c9 100%); color: white; box-shadow: 0 6px 16px #c32c9626; transform: rotate(-6deg); transition: transform 250ms var(--ease-out); }
  .instagram-mark :global(svg) { width: 28px; height: 28px; }
  .instagram-copy { display: grid; gap: 4px; }
  .instagram-copy strong { font-size: var(--t-small); font-weight: 600; }
  .instagram-copy small { font-size: 0.8125rem; color: var(--on-dark-soft); }
  .instagram-cta > :global(svg) { width: 16px; height: 16px; margin-left: 12px; flex: none; color: var(--brand-pale); }
  .instagram-cta:hover { transform: translateY(-3px); border-color: #d267b677; box-shadow: 0 10px 24px #c32c9614; }
  .instagram-cta:hover .instagram-mark { transform: rotate(0deg) scale(1.05); }

  .body { display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 48px; align-items: start; }
  .people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .person { display: grid; grid-template-columns: clamp(88px, 8vw, 120px) minmax(0, 1fr); gap: 20px; align-items: start; padding: 20px; background: var(--paper-2); }
  .portrait { aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; background: var(--brand); color: #fff; }
  .portrait span { font-size: var(--t-sub); font-weight: 700; letter-spacing: -0.05em; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .person-copy { display: flex; flex-direction: column; align-self: stretch; }
  .person h3 { font-size: var(--t-lead); font-weight: 600; letter-spacing: -0.035em; }
  .role { margin-top: 4px; font-size: var(--t-small); font-weight: 600; color: var(--brand-pale); }
  .bio { margin-top: 12px; max-width: 52ch; font-size: var(--t-body); line-height: 1.5; }
  .profile-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 16px; }
  .profile-links a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--brand-night); color: var(--brand-pale); text-decoration: none; transition: color 180ms, background-color 180ms, transform 180ms; }
  .profile-links a:hover { background: var(--brand); color: white; transform: translateY(-2px); }
  .profile-links :global(svg) { width: 22px; height: 22px; }

  .facts { position: relative; overflow: hidden; padding: 28px 24px; background: var(--brand-night); color: var(--on-dark); }
  .facts-art { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--brand-pale); opacity: 0.18; }
  .facts dl { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .facts dt { font-size: var(--t-small); color: var(--on-dark-soft); }
  .facts dd { font-size: var(--t-body); font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; gap: 16px; }
    h2 { font-size: var(--t-head-sm); padding-right: 0; }
    .head p { font-size: var(--t-body); }
    .body { grid-template-columns: 1fr; margin-top: 40px; }
    .people { grid-template-columns: 1fr; }
    .person { grid-template-columns: 88px 1fr; gap: 16px; padding: 16px; }
    .facts dl { grid-template-columns: 1fr 1fr; gap: 20px 16px; }
    .facts dd { font-size: var(--t-body); overflow-wrap: anywhere; }
  }
</style>
