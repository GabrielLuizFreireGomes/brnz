---
import { team, facts } from '../data/site';
---
<section class="team wrap" id="time" aria-labelledby="time-title">
  <div class="head">
    <h2 id="time-title" data-reveal>Quem faz a brnz</h2>
    <p data-reveal style="--i:1">Três pessoas, três ofícios, uma mesa só. Todo projeto passa pelas três antes de chegar até você.</p>
  </div>

  <div class="body">
    <ul class="people">
      {team.map((p, i) => (
        <li class="person" data-reveal style={`--i:${i}`}>
          <div class="portrait" aria-hidden="true"><span>{p.initials}</span></div>
          <div>
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="bio">{p.bio}</p>
          </div>
        </li>
      ))}
    </ul>
    <aside class="facts on-dark" data-reveal style="--i:2" aria-label="Onde e como atendemos">
      <svg class="facts-art" aria-hidden="true"><use href="#art-waves" /></svg>
      <dl>
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </aside>
  </div>
</section>

<style>
  .team { padding-block: var(--section); }
  .head { display: grid; grid-template-columns: var(--axis) 1fr; align-items: end; }
  h2 { font-size: var(--t-head); line-height: 0.95; letter-spacing: -0.045em; padding-right: 32px; }
  .head p { max-width: 34ch; font-size: var(--t-lead); line-height: 1.25; letter-spacing: -0.015em; }

  .body { display: grid; grid-template-columns: 8fr 4fr; gap: var(--gap); margin-top: 72px; align-items: start; }
  .people { display: grid; gap: 16px; }
  .person { display: grid; grid-template-columns: clamp(96px, 11vw, 168px) 1fr; gap: 28px; align-items: start; padding: 20px; background: var(--paper-2); }
  .portrait { aspect-ratio: 1; display: grid; place-items: center; background: var(--brand); color: #fff; }
  .portrait span { font-size: var(--t-sub); font-weight: 700; letter-spacing: -0.05em; }
  .person h3 { font-size: var(--t-lead); font-weight: 600; letter-spacing: -0.035em; }
  .role { margin-top: 4px; font-size: var(--t-small); font-weight: 600; color: var(--brand-pale); }
  .bio { margin-top: 12px; max-width: 52ch; font-size: var(--t-body); line-height: 1.5; }

  .facts { position: relative; overflow: hidden; padding: 28px 24px; background: var(--brand-night); color: var(--on-dark); min-height: 100%; }
  .facts-art { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--brand-pale); opacity: 0.18; }
  .facts dl { position: relative; display: grid; gap: 24px; }
  .facts dt { font-size: var(--t-small); color: var(--on-dark-soft); }
  .facts dd { font-size: var(--t-lead); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; gap: 16px; }
    h2 { font-size: var(--t-head-sm); padding-right: 0; }
    .head p { font-size: var(--t-body); }
    .body { grid-template-columns: 1fr; margin-top: 40px; }
    .person { grid-template-columns: 88px 1fr; gap: 16px; padding: 16px; }
    .facts dl { grid-template-columns: 1fr 1fr; gap: 20px 16px; }
    .facts dd { font-size: var(--t-body); overflow-wrap: anywhere; }
  }
</style>
