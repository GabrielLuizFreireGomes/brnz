---
import { builderOptions, whatsappUrl, whatsappNumber } from '../data/site';
import Arrow from './Arrow.astro';
const preset = ['posts', 'video', 'site'];
---
<section class="builder wrap on-dark" id="monte" aria-labelledby="monte-title" data-builder data-number={whatsappNumber}>
  <div class="intro">
    <h2 id="monte-title" data-reveal>Nenhum encaixa?<br />Monte o seu.</h2>
    <p data-reveal style="--i:1">Marque o que a sua marca precisa. A mensagem do orçamento sai pronta, é só enviar no WhatsApp.</p>
    <div class="compare" data-reveal style="--i:2" aria-live="polite">
      <p class="side">
        <span class="num" data-count>3</span>
        <span class="what">profissionais para contratar separado: <span data-roles>social media, editor de vídeo e desenvolvedor</span>.</span>
      </p>
      <p class="side us">
        <span class="num">1</span>
        <span class="what">conversa com a brnz, com um time só para tudo isso.</span>
      </p>
    </div>
  </div>

  <div class="panel" data-reveal style="--i:3">
    <fieldset>
      <legend>O que você precisa</legend>
      <div class="chips">
        {builderOptions.map((o) => (
          <label class="chip">
            <input type="checkbox" name="servico" value={o.id} data-label={o.label} data-role={o.role} checked={preset.includes(o.id)} />
            <span>{o.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <label class="field">
      <span>Seu negócio <small>(opcional)</small></span>
      <input type="text" name="negocio" placeholder="Ex.: loja de roupas, hamburgueria…" autocomplete="organization" maxlength="60" />
    </label>

    <p class="preview"><span>Sua mensagem</span> <q data-preview>Olá, brnz! Preciso de posts e redes, edição de vídeo e site ou landing page. Pode me passar um orçamento?</q></p>
    <a class="btn btn--light send" href={whatsappUrl} target="_blank" rel="noopener" data-send>Pedir esse orçamento <Arrow /></a>
  </div>
</section>

<style>
  .builder {
    display: grid; grid-template-columns: var(--axis) 1fr; gap: 48px 0;
    padding-block: var(--section);
    background: var(--brand); color: var(--on-dark);
  }
  .intro { display: flex; flex-direction: column; padding-right: 48px; }
  h2 { font-size: var(--t-head); line-height: 0.95; letter-spacing: -0.045em; }
  .intro p { max-width: 30ch; margin-top: 28px; font-size: var(--t-body); line-height: 1.45; }

  .panel { display: grid; gap: 32px; }
  fieldset { border: 0; padding: 0; min-width: 0; }
  legend, .field > span { padding: 0; margin-bottom: 14px; font-size: var(--t-small); font-weight: 600; }
  .field small { font-size: inherit; font-weight: 400; color: var(--on-dark-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 18px;
    background: var(--brand-deep); color: var(--on-dark);
    font-size: var(--t-body); font-weight: 500;
    transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .chip span::before { content: '+'; font-weight: 600; width: 1ch; transition: transform var(--t-fast) var(--ease-out); }
  .chip:hover span { background: var(--brand-night); }
  .chip input:checked + span { background: var(--on-dark); color: var(--navy); }
  .chip input:checked + span::before { content: ''; width: 0.4em; height: 0.75em; margin: -0.2em 0.15em 0 0.1em; border: solid currentColor; border-width: 0 2px 2px 0; rotate: 45deg; }
  .chip input:focus-visible + span { outline: 3px solid var(--brand-pale); outline-offset: 3px; }
  .chip:active span { transform: scale(0.97); }

  .field { display: grid; max-width: 520px; }
  .field input {
    min-height: 52px; padding: 0 16px; border: 0; border-radius: 0;
    background: var(--brand-deep); color: var(--on-dark); font-size: var(--t-body);
  }
  .field input::placeholder { color: var(--on-dark-soft); }
  .field input:focus-visible { outline: 3px solid var(--brand-pale); outline-offset: 0; }

  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: auto; padding-top: 48px; }
  .side { display: grid; align-content: start; gap: 12px; padding: 24px 24px 28px; background: var(--brand-deep); }
  .side.us { background: var(--on-dark); color: var(--navy); }
  .num { font-size: var(--t-display); font-weight: 700; letter-spacing: -0.06em; line-height: 0.85; font-variant-numeric: tabular-nums; }
  .what { font-size: var(--t-small); line-height: 1.45; max-width: 32ch; }
  .preview { font-size: var(--t-small); line-height: 1.5; color: var(--on-dark-soft); max-width: 60ch; }
  .preview span { display: block; color: var(--on-dark); font-weight: 600; margin-bottom: 4px; }
  .preview q { quotes: '“' '”'; }
  .send { justify-self: start; }

  .num.bump { animation: bump 360ms var(--ease-out); }
  @keyframes bump { from { transform: translateY(10px); opacity: 0.3; } to { transform: none; opacity: 1; } }

  @media (max-width: 900px) {
    .builder { grid-template-columns: 1fr; }
    .intro { padding-right: 0; }
    h2 { font-size: var(--t-head-sm); }
    .compare { grid-template-columns: 1fr 1fr; }
    .side { padding: 18px 16px 20px; }
    .send { justify-self: stretch; justify-content: space-between; }
  }
</style>

<script>
  const list = (items: string[]) =>
    items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} e ${items[items.length - 1]}`;

  document.querySelectorAll<HTMLElement>('[data-builder]').forEach((root) => {
    const number = root.dataset.number!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[name="servico"]')];
    const business = root.querySelector<HTMLInputElement>('input[name="negocio"]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const roles = root.querySelector<HTMLElement>('[data-roles]')!;
    const preview = root.querySelector<HTMLElement>('[data-preview]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]')!;

    const update = () => {
      const picked = boxes.filter((b) => b.checked);
      const n = picked.length;
      const before = count.textContent;
      count.textContent = String(n);
      if (before !== count.textContent) {
        count.classList.remove('bump');
        void count.offsetWidth;
        count.classList.add('bump');
      }
      const lead = root.querySelector('.side .what')!.firstChild!;
      lead.textContent = n === 0 ? 'Marque ao menos uma opção acima' : n === 1 ? 'profissional para contratar separado: ' : 'profissionais para contratar separado: ';
      roles.textContent = n ? list(picked.map((b) => b.dataset.role!)) : '';
      const what = n ? list(picked.map((b) => b.dataset.label!.toLowerCase())) : 'ajuda com a minha marca';
      const who = business.value.trim();
      const text = `Olá, brnz! ${who ? `Meu negócio: ${who}. ` : ''}Preciso de ${what}. Pode me passar um orçamento?`;
      preview.textContent = text;
      send.href = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
    };
    boxes.forEach((b) => b.addEventListener('change', update));
    business.addEventListener('input', update);
    update();
  });
</script>
