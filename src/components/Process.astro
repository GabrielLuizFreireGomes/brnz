---
import { stages } from '../data/site';
const [first, ...rest] = stages;
---
<section class="process wrap" id="processo" aria-labelledby="processo-title">
  <ol class="stairs">
    <li style="--s:0" data-reveal>
      <h2 id="processo-title">{first.line}</h2>
      <p>{first.text}</p>
    </li>
    {rest.map((s, i) => (
      <li style={`--s:${i + 1}`} data-reveal>
        <h3>{s.line}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .process { padding-block: var(--section); }
  .stairs { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 40px; }
  .stairs li { grid-column: calc(1 + var(--s) * 2) / -1; }
  .stairs h2, .stairs h3 { font-size: var(--t-head); font-weight: 600; line-height: 1; letter-spacing: -0.045em; white-space: nowrap; }
  .stairs li:last-child h3 { color: var(--brand-pale); }
  .stairs p { max-width: 34ch; margin-top: 16px; font-size: var(--t-body); line-height: 1.5; color: var(--ink-soft); }

  @media (max-width: 860px) {
    .stairs { display: block; }
    .stairs li { margin-left: calc(var(--s) * 6vw); }
    .stairs li + li { margin-top: 40px; }
    .stairs h2, .stairs h3 { font-size: var(--t-head-sm); white-space: normal; }
    .stairs p { font-size: var(--t-body); }
  }
</style>
