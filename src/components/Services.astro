---
import { services } from '../data/site';
import Arrow from './Arrow.astro';
---
<section class="services" id="servicos" aria-labelledby="servicos-title">
  <div class="statement on-light">
    <h2 id="servicos-title" class="zig" data-reveal>
      <span>Do post</span>
      <span>ao site.</span>
    </h2>
    <div class="foot" data-reveal style="--i:1">
      <p>Cinco frentes com uma direção visual só. Você contrata uma ou todas, e o time é o mesmo.</p>
      <a class="btn" href="#pacotes">Ver pacotes <Arrow /></a>
    </div>
  </div>
  <ul class="rows on-dark">
    {services.map((s, i) => (
      <li class="row" data-reveal style={`--i:${i}`}>
        <h3>{s.name}</h3>
        <p>{s.text}</p>
        <ul class="terms">{s.terms.map((t) => <li>{t}</li>)}</ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .services { display: grid; grid-template-columns: 1fr 1fr; }
  .statement {
    display: flex; flex-direction: column; justify-content: space-between; gap: 48px;
    padding: clamp(48px, 6vw, 88px) var(--margin);
    background: var(--brand-mist); color: var(--navy);
  }
  .zig { display: grid; font-size: var(--t-head); line-height: 0.95; letter-spacing: -0.045em; }
  .zig span:nth-child(2) { text-align: right; }
  .foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .foot p { max-width: 30ch; font-size: var(--t-body); line-height: 1.45; }
  .foot .btn { flex: none; }

  .rows { display: grid; grid-auto-rows: 1fr; background: var(--brand-night); color: var(--on-dark); }
  .row {
    display: grid; grid-template-columns: 5fr 4fr 3fr; gap: 20px; align-items: start;
    padding: 24px var(--margin) 24px 28px;
  }
  .row:nth-child(even) { background: var(--brand-night-2); }
  .row h3 { font-size: var(--t-lead); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .row p { font-size: var(--t-small); line-height: 1.5; }
  .terms { display: grid; gap: 4px; font-size: var(--t-small); line-height: 1.4; color: var(--on-dark-soft); }

  @media (max-width: 1100px) {
    .row { grid-template-columns: 1fr 1fr; }
    .row h3 { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    .services { grid-template-columns: 1fr; }
    .statement { min-height: 0; padding-block: 56px 48px; gap: 64px; }
    .zig { font-size: var(--t-head-sm); }
    .foot { flex-direction: column; align-items: flex-start; }
    .row { grid-template-columns: 1fr; gap: 10px; padding: 28px var(--margin); }
    .terms { display: block; }
    .terms li { display: inline; }
    .terms li:not(:last-child)::after { content: ', '; }
  }
</style>
