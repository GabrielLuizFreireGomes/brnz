---
// O logotipo da brnz redesenhado em traço único, a partir da foto de perfil do Instagram:
// b com bojo redondo, r e n em arco, z reto. Usa currentColor; `draw` anima o traço na entrada.
interface Props { class?: string; draw?: boolean; title?: string }
const { class: cls, draw = false, title } = Astro.props;
---
<svg class:list={['brnz-logo', cls, { draw }]} viewBox="-12 -12 444 174" fill="none" stroke="currentColor" stroke-width="20" stroke-linejoin="miter" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <path pathLength="1" style="--k:0" d="M10 0 V100 A45 45 0 1 0 100 100 A45 45 0 1 0 10 100" />
  <path pathLength="1" style="--k:2" d="M135 150 V100 A45 45 0 0 1 180 55" />
  <path pathLength="1" style="--k:3" d="M215 150 V100 A45 45 0 0 1 305 100 V150" />
  <path pathLength="1" style="--k:4" d="M335 55 H410 L340 145 H415" />
</svg>

<style>
  .brnz-logo { display: block; overflow: visible; }
  .draw path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  @media (min-width: 0px) {
    .draw path { animation: brnz-draw 1400ms cubic-bezier(0.65, 0, 0.35, 1) backwards; animation-delay: calc(250ms + var(--k) * 180ms); }
  }
  @keyframes brnz-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
