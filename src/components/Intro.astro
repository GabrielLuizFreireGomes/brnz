---
import { intro } from '../data/site';
---
<section class="intro wrap" aria-labelledby="intro-title">
  <h2 id="intro-title" data-reveal>Cansado de contratar separado?</h2>
  <p class="lead" data-reveal style="--i:1">{intro.lead}</p>
  <div class="cols">
    {intro.columns.map((c, i) => (
      <p data-reveal style={`--i:${i + 2}`}><b>{c.run}</b> {c.text}</p>
    ))}
  </div>
</section>

<style>
  .intro { padding-block: clamp(72px, 8vw, 120px) var(--section); display: grid; grid-template-columns: var(--axis) 1fr; }
  h2 { grid-column: 1; font-size: var(--t-lead); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; max-width: 16ch; padding-top: 0.25em; padding-right: 32px; }
  .lead { grid-column: 2; font-size: var(--t-lead); line-height: 1.25; letter-spacing: -0.015em; max-width: 36ch; }
  .cols { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px var(--gap); margin-top: 72px; }
  .cols p { font-size: var(--t-small); line-height: 1.5; color: var(--ink-soft); }
  .cols b { color: var(--ink); font-weight: 700; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; }
    h2, .lead { grid-column: 1; }
    h2 { max-width: none; margin-bottom: 20px; padding-right: 0; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 20px; margin-top: 48px; }
  }
  @media (max-width: 560px) {
    .cols { grid-template-columns: 1fr; gap: 24px; }
    .cols p { font-size: var(--t-body); }
  }
</style>
