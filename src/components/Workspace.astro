---
import WorkspaceLogo from './WorkspaceLogo.astro';
import WorkspaceShowcase from './WorkspaceShowcase.astro';
import Arrow from './Arrow.astro';
import { wa } from '../data/site';
const inquiry = wa('Olá, brnz! Quero conhecer os planos com BRNZ Workspace para acompanhar os projetos da minha marca.');
---
<section class="workspace wrap" id="workspace" aria-labelledby="workspace-title">
  <div class="identity"><WorkspaceLogo /><span>Do pedido ao resultado.</span></div>
  <div class="overview">
    <h2 id="workspace-title">Seu time por perto.<br />Seu projeto à vista.</h2>
    <div class="pitch">
      <p>O que está sendo criado, o que precisa do seu ok e como sua marca está indo. Abra o BRNZ Workspace e acompanhe tudo, no computador ou no celular.</p>
      <div class="actions"><a class="btn btn--light" href={inquiry} target="_blank" rel="noopener">Quero meu time conectado <Arrow /></a><a class="plan-link" href="#pacotes">Comparar planos <span aria-hidden="true">→</span></a></div>
    </div>
  </div>
  <WorkspaceShowcase />
</section>
<style>
  .workspace { margin-inline: var(--margin); border-radius: var(--r-card); overflow: hidden; padding-block: clamp(32px, 4vw, 56px); background: var(--brand-night); color: var(--on-dark); }
  .identity { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid #aeb8ff33; }
  .identity > span { font-size: var(--t-small); color: var(--brand-pale); }
  .overview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; padding-block: 40px; }
  h2 { font-size: clamp(2.5rem, 3.7vw, 3.75rem); line-height: 1.18; }
  .pitch > p { max-width: 47ch; font-size: var(--t-body); line-height: 1.55; color: var(--on-dark-soft); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 24px; }
  .plan-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-size: var(--t-small); text-decoration: none; color: var(--on-dark-soft); }
  .plan-link:hover { color: var(--on-dark); }
  .plan-link > span { transition: transform 200ms var(--ease-out); }
  .plan-link:hover > span { transform: translateX(4px); }
  @media (max-width: 800px) { .overview { grid-template-columns: 1fr; gap: 24px; padding-block: 32px; } }
  @media (max-width: 560px) {
    .workspace { padding-inline: 20px; }
    .identity { gap: 12px; }
    .identity > span { font-size: 0.75rem; max-width: 12ch; text-align: right; }
    h2 { font-size: clamp(2.125rem, 8.7vw, 3rem); }
    .actions .btn { width: 100%; padding-inline: 16px; justify-content: space-between; font-size: 0.875rem; gap: 8px; }
  }
</style>
