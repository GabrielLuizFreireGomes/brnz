---
import { instagramUrl, instagramHandle, whatsappUrl, whatsappDisplay } from '../data/site';
import BrnzLogo from './BrnzLogo.astro';
const year = new Date().getFullYear();
---
<footer class="footer wrap on-dark">
  <div class="main">
    <div class="wordmark"><BrnzLogo /></div>
    <div class="side">
      <nav aria-label="Rodapé" class="links">
        <ul>
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#processo">Como funciona</a></li>
          <li><a href="#pacotes">Pacotes</a></li>
        </ul>
        <ul>
          <li><a href="#monte">Monte o seu</a></li>
          <li><a href="#time">Time</a></li>
          <li><a href="#duvidas">Dúvidas</a></li>
        </ul>
      </nav>
      <ul class="places">
        <li><a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp {whatsappDisplay}</a></li>
        <li><a href={instagramUrl} target="_blank" rel="noopener">Instagram {instagramHandle}</a></li>
      </ul>
    </div>
  </div>
  <div class="legal">
    <p>© {year} brnz · Estúdio criativo</p>
    <a href="#inicio">Voltar ao início <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer { overflow: hidden; padding-block: 120px 24px; background: var(--brand); color: var(--on-dark); }
  .main { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; }
  .wordmark { grid-column: 1 / span 6; min-width: 0; color: var(--on-dark); }
  .wordmark :global(svg) { width: 100%; height: auto; }
  .side { grid-column: 8 / span 5; min-width: 0; display: grid; gap: 48px; padding-bottom: 0.4vw; }
  .links { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--gap); }
  .links a, .legal a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--t-small); text-decoration: none; }
  .links a:hover, .legal a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .places { display: grid; gap: 4px; }
  .places a { font-size: var(--t-sub); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; color: var(--brand-pale); text-decoration: none; }
  .places a:hover { color: #fff; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .legal { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 56px; font-size: var(--t-small); color: var(--on-dark-soft); }
  .legal a { color: var(--on-dark); }

  @media (max-width: 900px) {
    .footer { padding-top: 144px; }
    .main { grid-template-columns: 1fr; row-gap: 48px; }
    .wordmark { grid-column: 1; }
    .side { grid-column: 1; gap: 32px; padding-bottom: 0; }
    .legal { margin-top: 48px; flex-wrap: wrap; }
  }
</style>
